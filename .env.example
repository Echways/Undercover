# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AA-replace-me

# --- PostgreSQL -------------------------------------------------------------
# Значения используются и сервисом postgres (создание БД/пользователя),
# и ботом (сборка DSN в config.py).
POSTGRES_DB=undercover
POSTGRES_USER=undercover
POSTGRES_PASSWORD=change-me
# Внутри docker compose это имя сервиса; при локальном запуске — localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
# Одна база на FSM aiogram и на игровые сессии — ключи не пересекаются
# (fsm:* против game:* / chat_active_game:*)
REDIS_URL=redis://redis:6379/0

# --- Логирование ------------------------------------------------------------
LOG_LEVEL=INFO
